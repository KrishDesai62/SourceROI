{
  "id": "my-first-agent",
  "name": "My First Agent",
  "runner": "rag_chat",
  "benchmark": "benchmark.jsonl",
  "model": {
    "name": "gpt-4.1-mini",
    "base_url": "https://api.openai.com/v1",
    "api_key_env": "OPENAI_API_KEY",
    "temperature": 0,
    "timeout_seconds": 90,
    "max_output_tokens": 500,
    "input_price_per_million_usd": null,
    "output_price_per_million_usd": null
