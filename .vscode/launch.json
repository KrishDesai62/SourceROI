{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "SourceROI: Live Dashboard",
      "type": "debugpy",
      "request": "launch",
      "module": "sourceroi",
      "args": ["serve"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "SourceROI: Original Synthetic Demo",
      "type": "debugpy",
      "request": "launch",
      "module": "sourceroi",
      "args": ["demo", "serve", "--port", "8766"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
